# Odoo 19 Postgres (prodart19), read-only user. Same names as Documents\Redbox\.env
DB_HOST=
DB_PORT=5432
DB_NAME=prodart19
DB_USER=
DB_PASS=

# img.artbox.kr catalog login (photos + package sizes)
ARTBOX_IMG_ID=
ARTBOX_IMG_PW=

# App database (SQLite)
DATABASE_URL=file:data/app.db

# Claude: the CLI's own claude.ai login is used (no API key). Optional overrides:
# CLAUDE_BIN=claude
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...   (only if the CLI login should be overridden)
MODEL_AGENT=claude-opus-5-5
EFFORT_AGENT=high
AGENT_MAX_PARALLEL=2

# LAN gateway (http://HQ-SJ07:3200): shared password colleagues type once
LAN_PASSWORD=
